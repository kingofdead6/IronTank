# MongoDB connection string (local Docker: mongodb://localhost:27017/ironrank, or an Atlas URI)
MONGO_URI=mongodb://localhost:27017/ironrank

# Secrets used to sign access / refresh JWTs. Use long random strings (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# HTTP port for the API
PORT=4000

# Optional
# NODE_ENV=development
# CORS_ORIGIN=*
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
